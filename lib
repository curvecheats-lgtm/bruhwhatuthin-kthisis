-- Extension Hook
local _origSetOpen = Library.SetOpen
function Library:SetOpen(bool)
    if typeof(bool) ~= "boolean" then return end
    if _origSetOpen then _origSetOpen(self, bool) else self.Open = bool end
    if self.Holder then self.Holder.Visible = bool end
    
    -- Sync widgets
    if not bool then
        pcall(function()
            if self._PopupGui then
                for _, child in ipairs(self._PopupGui:GetChildren()) do
                    if child:IsA("Frame") then child.Visible = false end
                end
            end
        end)
    end
end

