  local function applyKeybindList()
      local enabled = flag("kb_en", true)
      Kb.Visible = enabled
      if not enabled then return end
      for _, c in ipairs(KbBody:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end
