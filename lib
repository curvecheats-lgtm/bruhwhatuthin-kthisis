                                        elseif Value:sub(1, 6) == "string" then
                                                local String = Value:sub(8, #Value - 1)
                                                Value = String
                                        elseif Value:sub(1, 6) == "number" then
                                                local Number = tonumber(Value:sub(8, #Value - 1))
                                                Value = Number
